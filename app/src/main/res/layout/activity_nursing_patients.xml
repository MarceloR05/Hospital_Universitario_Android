<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    tools:context=".NursingPatientsActivity">

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNavContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="32dp">

            <!-- Top Wine Header -->
            <View
                android:id="@+id/viewHeader"
                android:layout_width="0dp"
                android:layout_height="202dp"
                android:background="@color/wine_primary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Hospital San Gabriel Header info -->
            <TextView
                android:id="@+id/tvHeaderHospital"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="54dp"
                android:layout_marginEnd="16dp"
                android:text="@string/hospital_san_gabriel"
                android:textColor="#F8E1E9"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/tvHeaderIcon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvHeaderIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:text="♧"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/tvHeaderHospital"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvHeaderHospital" />

            <!-- Screen Title -->
            <TextView
                android:id="@+id/tvScreenTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="24dp"
                android:text="@string/nursing_patients_title"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvHeaderHospital" />

            <!-- Screen Subtitle -->
            <TextView
                android:id="@+id/tvScreenSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="24dp"
                android:text="@string/nursing_patients_subtitle"
                android:textColor="#F7D5E1"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvScreenTitle" />

            <!-- Search Card -->
            <LinearLayout
                android:id="@+id/cardSearch"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_dashboard_card"
                android:elevation="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvScreenSubtitle">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⌕"
                    android:textColor="#737B89"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/nursing_search_patients_hint"
                    android:textColor="#737B89"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Section Title: Mi lista de pacientes -->
            <TextView
                android:id="@+id/tvPatientsListTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="19dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="19dp"
                android:text="@string/nursing_patients_list_title"
                android:textColor="#222937"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardSearch" />

            <!-- Filters Row -->
            <TextView
                android:id="@+id/tvFilters"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="20dp"
                android:text="@string/nursing_patients_filters"
                android:textColor="#737B89"
                android:textSize="11sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvPatientsListTitle" />

            <!-- Patient Card 1: Carlos Mendoza -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardPatient1"
                android:layout_width="0dp"
                android:layout_height="83dp"
                android:layout_marginStart="17dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="17dp"
                android:background="@drawable/bg_dashboard_card"
                android:clickable="true"
                android:focusable="true"
                android:elevation="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvFilters">

                <FrameLayout
                    android:id="@+id/flIcon1"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="13dp"
                    android:background="@drawable/bg_nav_selected"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="✚"
                        android:textColor="@color/wine_primary"
                        android:textSize="19sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvName1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="14dp"
                    android:text="@string/nursing_pat_1_name"
                    android:textColor="#222937"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/flIcon1"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvMeta1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="14dp"
                    android:text="@string/nursing_pat_1_meta"
                    android:textColor="#737B89"
                    android:textSize="11sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/flIcon1"
                    app:layout_constraintTop_toBottomOf="@id/tvName1" />

                <TextView
                    android:id="@+id/tvStatus1"
                    android:layout_width="142dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="11dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_badge_inprogress"
                    android:gravity="center"
                    android:text="@string/status_following"
                    android:textColor="#222937"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/flIcon1"
                    app:layout_constraintTop_toBottomOf="@id/tvMeta1" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Patient Card 2: María López -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardPatient2"
                android:layout_width="0dp"
                android:layout_height="83dp"
                android:layout_marginStart="17dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="17dp"
                android:background="@drawable/bg_dashboard_card"
                android:clickable="true"
                android:focusable="true"
                android:elevation="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardPatient1">

                <FrameLayout
                    android:id="@+id/flIcon2"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="13dp"
                    android:background="@drawable/bg_nav_selected"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="✚"
                        android:textColor="@color/wine_primary"
                        android:textSize="19sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvName2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="14dp"
                    android:text="@string/nursing_pat_2_name"
                    android:textColor="#222937"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/flIcon2"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvMeta2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="14dp"
                    android:text="@string/patient_2_meta"
                    android:textColor="#737B89"
                    android:textSize="11sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/flIcon2"
                    app:layout_constraintTop_toBottomOf="@id/tvName2" />

                <TextView
                    android:id="@+id/tvStatus2"
                    android:layout_width="142dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="11dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_badge_waiting"
                    android:gravity="center"
                    android:text="@string/status_waiting"
                    android:textColor="#222937"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/flIcon2"
                    app:layout_constraintTop_toBottomOf="@id/tvMeta2" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Patient Card 3: Roberto Díaz -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardPatient3"
                android:layout_width="0dp"
                android:layout_height="83dp"
                android:layout_marginStart="17dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="17dp"
                android:background="@drawable/bg_dashboard_card"
                android:clickable="true"
                android:focusable="true"
                android:elevation="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardPatient2">

                <FrameLayout
                    android:id="@+id/flIcon3"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="13dp"
                    android:background="@drawable/bg_nav_selected"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="✚"
                        android:textColor="@color/wine_primary"
                        android:textSize="19sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvName3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="14dp"
                    android:text="@string/nursing_pat_3_name"
                    android:textColor="#222937"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/flIcon3"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvMeta3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="14dp"
                    android:text="@string/nursing_pat_3_meta"
                    android:textColor="#737B89"
                    android:textSize="11sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/flIcon3"
                    app:layout_constraintTop_toBottomOf="@id/tvName3" />

                <TextView
                    android:id="@+id/tvStatus3"
                    android:layout_width="142dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="11dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_badge_inprogress"
                    android:gravity="center"
                    android:text="@string/status_following"
                    android:textColor="#222937"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/flIcon3"
                    app:layout_constraintTop_toBottomOf="@id/tvMeta3" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Patient Card 4: Lucía García -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardPatient4"
                android:layout_width="0dp"
                android:layout_height="83dp"
                android:layout_marginStart="17dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="17dp"
                android:background="@drawable/bg_dashboard_card"
                android:clickable="true"
                android:focusable="true"
                android:elevation="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardPatient3">

                <FrameLayout
                    android:id="@+id/flIcon4"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="13dp"
                    android:background="@drawable/bg_nav_selected"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="✚"
                        android:textColor="@color/wine_primary"
                        android:textSize="19sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvName4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="14dp"
                    android:text="@string/nursing_pat_4_name"
                    android:textColor="#222937"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/flIcon4"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvMeta4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="14dp"
                    android:text="@string/nursing_pat_4_meta"
                    android:textColor="#737B89"
                    android:textSize="11sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/flIcon4"
                    app:layout_constraintTop_toBottomOf="@id/tvName4" />

                <TextView
                    android:id="@+id/tvStatus4"
                    android:layout_width="142dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="11dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_badge_confirmed"
                    android:gravity="center"
                    android:text="@string/status_stable"
                    android:textColor="#222937"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/flIcon4"
                    app:layout_constraintTop_toBottomOf="@id/tvMeta4" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Patient Card 5: Ana Herrera -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardPatient5"
                android:layout_width="0dp"
                android:layout_height="83dp"
                android:layout_marginStart="17dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="17dp"
                android:background="@drawable/bg_dashboard_card"
                android:clickable="true"
                android:focusable="true"
                android:elevation="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardPatient4">

                <FrameLayout
                    android:id="@+id/flIcon5"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="13dp"
                    android:background="@drawable/bg_nav_selected"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="✚"
                        android:textColor="@color/wine_primary"
                        android:textSize="19sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvName5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="14dp"
                    android:text="@string/nursing_pat_5_name"
                    android:textColor="#222937"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/flIcon5"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvMeta5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="14dp"
                    android:text="@string/nursing_pat_5_meta"
                    android:textColor="#737B89"
                    android:textSize="11sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/flIcon5"
                    app:layout_constraintTop_toBottomOf="@id/tvName5" />

                <TextView
                    android:id="@+id/tvStatus5"
                    android:layout_width="142dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="11dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_badge_waiting"
                    android:gravity="center"
                    android:text="@string/status_waiting"
                    android:textColor="#222937"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/flIcon5"
                    app:layout_constraintTop_toBottomOf="@id/tvMeta5" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar Container (Nursing) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="0dp"
        android:layout_height="74dp"
        android:background="@color/white"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Tab 1: Inicio -->
        <LinearLayout
            android:id="@+id/tabInicio"
            android:layout_width="67dp"
            android:layout_height="51dp"
            android:layout_marginStart="12dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌂"
                android:textColor="#737B89"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/nav_inicio"
                android:textColor="#737B89"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Tab 2: Pacientes (Selected) -->
        <LinearLayout
            android:id="@+id/tabPacientes"
            android:layout_width="70dp"
            android:layout_height="51dp"
            android:background="@drawable/bg_nav_selected"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tabPreconsulta"
            app:layout_constraintStart_toEndOf="@id/tabInicio"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="♙"
                android:textColor="@color/wine_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/nav_patients"
                android:textColor="@color/wine_primary"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab 3: Preconsulta -->
        <LinearLayout
            android:id="@+id/tabPreconsulta"
            android:layout_width="70dp"
            android:layout_height="51dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tabHabitaciones"
            app:layout_constraintStart_toEndOf="@id/tabPacientes"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="♡"
                android:textColor="#737B89"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/nav_nursing_preconsult"
                android:textColor="#737B89"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Tab 4: Habitaciones -->
        <LinearLayout
            android:id="@+id/tabHabitaciones"
            android:layout_width="70dp"
            android:layout_height="51dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tabMas"
            app:layout_constraintStart_toEndOf="@id/tabPreconsulta"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
