<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    tools:context=".AppointmentsActivity">

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNavContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="90dp">

            <!-- Top Wine Header -->
            <View
                android:id="@+id/viewHeader"
                android:layout_width="0dp"
                android:layout_height="202dp"
                android:background="@color/wine_primary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Hospital San Gabriel Header info -->
            <TextView
                android:id="@+id/tvHeaderHospital"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="54dp"
                android:layout_marginEnd="16dp"
                android:text="@string/hospital_san_gabriel"
                android:textColor="#F9E4EA"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/tvHeaderIcon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvHeaderIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:text="♧"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/tvHeaderHospital"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvHeaderHospital" />

            <!-- Screen Title -->
            <TextView
                android:id="@+id/tvScreenTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="24dp"
                android:text="@string/appointments_title"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvHeaderHospital" />

            <!-- Screen Subtitle -->
            <TextView
                android:id="@+id/tvScreenSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="24dp"
                android:text="@string/appointments_subtitle"
                android:textColor="#F6D7E2"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvScreenTitle" />

            <!-- Search Card -->
            <LinearLayout
                android:id="@+id/cardSearch"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_dashboard_card"
                android:elevation="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvScreenSubtitle">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⌕"
                    android:textColor="#737B89"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/search_appointments_hint"
                    android:textColor="#737B89"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Date Section Title -->
            <TextView
                android:id="@+id/tvDateTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="20dp"
                android:text="@string/appointments_date_title"
                android:textColor="#202734"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardSearch" />

            <!-- Date Navigation Row -->
            <TextView
                android:id="@+id/tvDateNav"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="21dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="21dp"
                android:text="@string/appointments_date_nav"
                android:textColor="#737B89"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvDateTitle" />

            <!-- Appointment Card 1: 08:00 · María López -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardApt1"
                android:layout_width="0dp"
                android:layout_height="86dp"
                android:layout_marginStart="17dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="17dp"
                android:background="@drawable/bg_dashboard_card"
                android:clickable="true"
                android:focusable="true"
                android:elevation="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvDateNav">

                <FrameLayout
                    android:id="@+id/flIcon1"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/bg_nav_selected"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="✚"
                        android:textColor="@color/wine_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvTimeName1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="14dp"
                    android:text="@string/apt_1_time_name"
                    android:textColor="#202734"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/flIcon1"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvMeta1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="14dp"
                    android:text="@string/apt_1_meta"
                    android:textColor="#737B89"
                    android:textSize="11sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/flIcon1"
                    app:layout_constraintTop_toBottomOf="@id/tvTimeName1" />

                <TextView
                    android:id="@+id/tvStatus1"
                    android:layout_width="121dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_badge_confirmed"
                    android:gravity="center"
                    android:text="@string/status_confirmed"
                    android:textColor="#202734"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/flIcon1"
                    app:layout_constraintTop_toBottomOf="@id/tvMeta1" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Appointment Card 2: 09:30 · Carlos Mendoza -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardApt2"
                android:layout_width="0dp"
                android:layout_height="86dp"
                android:layout_marginStart="17dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="17dp"
                android:background="@drawable/bg_dashboard_card"
                android:clickable="true"
                android:focusable="true"
                android:elevation="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardApt1">

                <FrameLayout
                    android:id="@+id/flIcon2"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/bg_nav_selected"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="✚"
                        android:textColor="@color/wine_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvTimeName2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="14dp"
                    android:text="@string/apt_2_time_name"
                    android:textColor="#202734"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/flIcon2"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvMeta2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="14dp"
                    android:text="@string/apt_2_meta"
                    android:textColor="#737B89"
                    android:textSize="11sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/flIcon2"
                    app:layout_constraintTop_toBottomOf="@id/tvTimeName2" />

                <TextView
                    android:id="@+id/tvStatus2"
                    android:layout_width="121dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_badge_waiting"
                    android:gravity="center"
                    android:text="@string/status_waiting"
                    android:textColor="#202734"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/flIcon2"
                    app:layout_constraintTop_toBottomOf="@id/tvMeta2" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Appointment Card 3: 11:00 · Lucía García -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardApt3"
                android:layout_width="0dp"
                android:layout_height="86dp"
                android:layout_marginStart="17dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="17dp"
                android:background="@drawable/bg_dashboard_card"
                android:clickable="true"
                android:focusable="true"
                android:elevation="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardApt2">

                <FrameLayout
                    android:id="@+id/flIcon3"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/bg_nav_selected"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="✚"
                        android:textColor="@color/wine_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvTimeName3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="14dp"
                    android:text="@string/apt_3_time_name"
                    android:textColor="#202734"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/flIcon3"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvMeta3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="14dp"
                    android:text="@string/apt_3_meta"
                    android:textColor="#737B89"
                    android:textSize="11sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/flIcon3"
                    app:layout_constraintTop_toBottomOf="@id/tvTimeName3" />

                <TextView
                    android:id="@+id/tvStatus3"
                    android:layout_width="121dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_badge_confirmed"
                    android:gravity="center"
                    android:text="@string/status_confirmed"
                    android:textColor="#202734"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/flIcon3"
                    app:layout_constraintTop_toBottomOf="@id/tvMeta3" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Appointment Card 4: 13:30 · Juan Pérez -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardApt4"
                android:layout_width="0dp"
                android:layout_height="86dp"
                android:layout_marginStart="17dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="17dp"
                android:background="@drawable/bg_dashboard_card"
                android:clickable="true"
                android:focusable="true"
                android:elevation="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardApt3">

                <FrameLayout
                    android:id="@+id/flIcon4"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/bg_nav_selected"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="✚"
                        android:textColor="@color/wine_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvTimeName4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="14dp"
                    android:text="@string/apt_4_time_name"
                    android:textColor="#202734"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/flIcon4"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvMeta4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="14dp"
                    android:text="@string/apt_4_meta"
                    android:textColor="#737B89"
                    android:textSize="11sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/flIcon4"
                    app:layout_constraintTop_toBottomOf="@id/tvTimeName4" />

                <TextView
                    android:id="@+id/tvStatus4"
                    android:layout_width="121dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_badge_inprogress"
                    android:gravity="center"
                    android:text="@string/status_inprogress"
                    android:textColor="#202734"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/flIcon4"
                    app:layout_constraintTop_toBottomOf="@id/tvMeta4" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Appointment Card 5: 15:00 · Roberto Díaz -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardApt5"
                android:layout_width="0dp"
                android:layout_height="86dp"
                android:layout_marginStart="17dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="17dp"
                android:background="@drawable/bg_dashboard_card"
                android:clickable="true"
                android:focusable="true"
                android:elevation="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardApt4">

                <FrameLayout
                    android:id="@+id/flIcon5"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/bg_nav_selected"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="✚"
                        android:textColor="@color/wine_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvTimeName5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="14dp"
                    android:text="@string/apt_5_time_name"
                    android:textColor="#202734"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/flIcon5"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvMeta5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="14dp"
                    android:text="@string/apt_5_meta"
                    android:textColor="#737B89"
                    android:textSize="11sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/flIcon5"
                    app:layout_constraintTop_toBottomOf="@id/tvTimeName5" />

                <TextView
                    android:id="@+id/tvStatus5"
                    android:layout_width="121dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_badge_waiting"
                    android:gravity="center"
                    android:text="@string/status_pending"
                    android:textColor="#202734"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/flIcon5"
                    app:layout_constraintTop_toBottomOf="@id/tvMeta5" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- + Agendar cita Button -->
            <Button
                android:id="@+id/btnNewAppointment"
                android:layout_width="148dp"
                android:layout_height="34dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="17dp"
                android:background="@drawable/bg_button_wine"
                android:text="@string/btn_new_appointment"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardApt5" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="0dp"
        android:layout_height="74dp"
        android:background="@color/white"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Tab 1: Inicio -->
        <LinearLayout
            android:id="@+id/tabInicio"
            android:layout_width="63dp"
            android:layout_height="53dp"
            android:layout_marginStart="13dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌂"
                android:textColor="#737B89"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_inicio"
                android:textColor="#737B89"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tab 2: Pacientes -->
        <LinearLayout
            android:id="@+id/tabPacientes"
            android:layout_width="63dp"
            android:layout_height="53dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tabCitas"
            app:layout_constraintStart_toEndOf="@id/tabInicio"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="♙"
                android:textColor="#737B89"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_patients"
                android:textColor="#737B89"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tab 3: Citas (Selected) -->
        <LinearLayout
            android:id="@+id/tabCitas"
            android:layout_width="66dp"
            android:layout_height="53dp"
            android:background="@drawable/bg_nav_selected"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tabTurnos"
            app:layout_constraintStart_toEndOf="@id/tabPacientes"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▦"
                android:textColor="@color/wine_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_appointments"
                android:textColor="@color/wine_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab 4: Turnos -->
        <LinearLayout
            android:id="@+id/tabTurnos"
            android:layout_width="63dp"
            android:layout_height="53dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tabMas"
            app:layout_constraintStart_toEndOf="@id/tabCitas"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◷"
                android:textColor="#737B89"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_turns"
                android:textColor="#737B89"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tab 5: Más -->
        <LinearLayout
            android:id="@+id/tabMas"
            android:layout_width="63dp"
            android:layout_height="53dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tabTurnos"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☰"
                android:textColor="#737B89"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_more"
                android:textColor="#737B89"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Bottom Navigation Indicator bar -->
        <View
            android:layout_width="123dp"
            android:layout_height="4dp"
            android:layout_marginBottom="4dp"
            android:background="#202734"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
