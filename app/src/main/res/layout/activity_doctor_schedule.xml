<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    tools:context=".DoctorScheduleActivity">

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNavContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="40dp">

            <!-- Top Wine Header -->
            <View
                android:id="@+id/viewHeader"
                android:layout_width="0dp"
                android:layout_height="202dp"
                android:background="@color/wine_primary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Hospital San Gabriel Header info -->
            <TextView
                android:id="@+id/tvHeaderHospital"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="54dp"
                android:layout_marginEnd="16dp"
                android:text="@string/hospital_san_gabriel"
                android:textColor="#F8E1E9"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/tvHeaderIcon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvHeaderIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:text="♧"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/tvHeaderHospital"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvHeaderHospital" />

            <!-- Screen Title -->
            <TextView
                android:id="@+id/tvScreenTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="24dp"
                android:text="@string/doctor_schedule_title"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvHeaderHospital" />

            <!-- Screen Subtitle -->
            <TextView
                android:id="@+id/tvScreenSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="24dp"
                android:text="@string/doctor_schedule_subtitle"
                android:textColor="#F7D5E1"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvScreenTitle" />

            <!-- Search Card -->
            <LinearLayout
                android:id="@+id/cardSearch"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_dashboard_card"
                android:elevation="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvScreenSubtitle">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⌕"
                    android:textColor="#737B89"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/doctor_search_schedule_hint"
                    android:textColor="#737B89"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Section Title 1: Próxima jornada -->
            <TextView
                android:id="@+id/tvNextShiftTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="19dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="19dp"
                android:text="@string/doctor_next_shift_title"
                android:textColor="#222937"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardSearch" />

            <!-- Next Shift Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardNextShift"
                android:layout_width="0dp"
                android:layout_height="115dp"
                android:layout_marginStart="17dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="17dp"
                android:background="@drawable/bg_dashboard_card"
                android:clickable="true"
                android:focusable="true"
                android:elevation="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvNextShiftTitle">

                <TextView
                    android:id="@+id/tvShiftDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginEnd="14dp"
                    android:text="@string/doctor_next_shift_date"
                    android:textColor="@color/wine_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvShiftTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="14dp"
                    android:text="@string/doctor_next_shift_time"
                    android:textColor="#222937"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvShiftDate" />

                <TextView
                    android:id="@+id/tvShiftStatus"
                    android:layout_width="122dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_badge_confirmed"
                    android:gravity="center"
                    android:text="@string/status_confirmed"
                    android:textColor="#222937"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvShiftTime" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Section Title 2: Agenda semanal -->
            <TextView
                android:id="@+id/tvWeekTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="19dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="19dp"
                android:text="@string/doctor_week_schedule_title"
                android:textColor="#222937"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardNextShift" />

            <!-- Shift Card 1: Lunes 19 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardShift1"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="17dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="17dp"
                android:background="@drawable/bg_dashboard_card"
                android:clickable="true"
                android:focusable="true"
                android:elevation="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvWeekTitle">

                <TextView
                    android:id="@+id/tvDay1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="14dp"
                    android:text="@string/doc_sch_1_day"
                    android:textColor="#222937"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/tvBadge1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvTime1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="1dp"
                    android:layout_marginEnd="14dp"
                    android:text="@string/doc_sch_1_time"
                    android:textColor="#737B89"
                    android:textSize="11sp"
                    app:layout_constraintEnd_toStartOf="@id/tvBadge1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvDay1" />

                <TextView
                    android:id="@+id/tvBadge1"
                    android:layout_width="93dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_badge_inprogress"
                    android:gravity="center"
                    android:text="@string/shift_morning"
                    android:textColor="#222937"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Shift Card 2: Martes 20 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardShift2"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="17dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="17dp"
                android:background="@drawable/bg_dashboard_card"
                android:clickable="true"
                android:focusable="true"
                android:elevation="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardShift1">

                <TextView
                    android:id="@+id/tvDay2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="14dp"
                    android:text="@string/doc_sch_2_day"
                    android:textColor="#222937"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/tvBadge2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvTime2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="1dp"
                    android:layout_marginEnd="14dp"
                    android:text="@string/doc_sch_2_time"
                    android:textColor="#737B89"
                    android:textSize="11sp"
                    app:layout_constraintEnd_toStartOf="@id/tvBadge2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvDay2" />

                <TextView
                    android:id="@+id/tvBadge2"
                    android:layout_width="93dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_badge_inprogress"
                    android:gravity="center"
                    android:text="@string/shift_morning"
                    android:textColor="#222937"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Shift Card 3: Miércoles 21 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardShift3"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="17dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="17dp"
                android:background="@drawable/bg_dashboard_card"
                android:clickable="true"
                android:focusable="true"
                android:elevation="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardShift2">

                <TextView
                    android:id="@+id/tvDay3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="14dp"
                    android:text="@string/doc_sch_3_day"
                    android:textColor="#222937"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/tvBadge3"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvTime3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="1dp"
                    android:layout_marginEnd="14dp"
                    android:text="@string/doc_sch_3_time"
                    android:textColor="#737B89"
                    android:textSize="11sp"
                    app:layout_constraintEnd_toStartOf="@id/tvBadge3"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvDay3" />

                <TextView
                    android:id="@+id/tvBadge3"
                    android:layout_width="93dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_badge_inprogress"
                    android:gravity="center"
                    android:text="@string/shift_morning"
                    android:textColor="#222937"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Shift Card 4: Jueves 22 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardShift4"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="17dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="17dp"
                android:background="@drawable/bg_dashboard_card"
                android:clickable="true"
                android:focusable="true"
                android:elevation="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardShift3">

                <TextView
                    android:id="@+id/tvDay4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="14dp"
                    android:text="@string/doc_sch_4_day"
                    android:textColor="#222937"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/tvBadge4"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvTime4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="1dp"
                    android:layout_marginEnd="14dp"
                    android:text="@string/doc_sch_4_desc"
                    android:textColor="#737B89"
                    android:textSize="11sp"
                    app:layout_constraintEnd_toStartOf="@id/tvBadge4"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvDay4" />

                <TextView
                    android:id="@+id/tvBadge4"
                    android:layout_width="93dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_badge_inprogress"
                    android:gravity="center"
                    android:text="@string/shift_afternoon"
                    android:textColor="#222937"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Shift Card 5: Viernes 23 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardShift5"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="17dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="17dp"
                android:background="@drawable/bg_dashboard_card"
                android:clickable="true"
                android:focusable="true"
                android:elevation="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardShift4">

                <TextView
                    android:id="@+id/tvDay5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="14dp"
                    android:text="@string/doc_sch_5_day"
                    android:textColor="#222937"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/tvBadge5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvTime5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="1dp"
                    android:layout_marginEnd="14dp"
                    android:text="@string/doc_sch_5_desc"
                    android:textColor="#737B89"
                    android:textSize="11sp"
                    app:layout_constraintEnd_toStartOf="@id/tvBadge5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvDay5" />

                <TextView
                    android:id="@+id/tvBadge5"
                    android:layout_width="93dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_badge_waiting"
                    android:gravity="center"
                    android:text="@string/shift_free"
                    android:textColor="#222937"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar Container (Doctor) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="0dp"
        android:layout_height="74dp"
        android:background="@color/white"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Tab 1: Inicio -->
        <LinearLayout
            android:id="@+id/tabInicio"
            android:layout_width="70dp"
            android:layout_height="51dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tabCitas"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌂"
                android:textColor="#737B89"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/nav_inicio"
                android:textColor="#737B89"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Tab 2: Mis citas -->
        <LinearLayout
            android:id="@+id/tabCitas"
            android:layout_width="70dp"
            android:layout_height="51dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tabConsulta"
            app:layout_constraintStart_toEndOf="@id/tabInicio"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▦"
                android:textColor="#737B89"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/nav_doctor_appointments"
                android:textColor="#737B89"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Tab 3: Consulta -->
        <LinearLayout
            android:id="@+id/tabConsulta"
            android:layout_width="70dp"
            android:layout_height="51dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tabExpediente"
            app:layout_constraintStart_toEndOf="@id/tabCitas"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✚"
                android:textColor="#737B89"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/nav_doctor_consult"
                android:textColor="#737B89"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Tab 4: Expediente -->
        <LinearLayout
            android:id="@+id/tabExpediente"
            android:layout_width="70dp"
            android:layout_height="51dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tabMas"
            app:layout_constraintStart_toEndOf="@id/tabConsulta"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▤"
                android:textColor="#737B89"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/nav_doctor_records"
                android:textColor="#737B89"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Tab 5: Más (Selected) -->
        <LinearLayout
            android:id="@+id/tabMas"
            android:layout_width="70dp"
            android:layout_height="51dp"
            android:background="@drawable/bg_nav_selected"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tabExpediente"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
